# ── Anthropic (required) ──────────────────────────────────────
# Sign up at https://console.anthropic.com — new accounts get $5 free credit
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# ── IBM Cloud Object Storage (optional — falls back to local disk) ──
COS_ENDPOINT=
COS_API_KEY_ID=
COS_INSTANCE_CRN=
COS_BUCKET_NAME=

# ── App settings ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

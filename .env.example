# ── LLM Provider (ollama / bedrock / anthropic) ─────────────────
# Options:
#  - "ollama"  : Local LLM or private vLLM on AWS EC2 (NO API keys required)
#  - "bedrock" : AWS Bedrock serverless models (uses AWS IAM credentials)
#  - "anthropic": Anthropic Claude API
LLM_PROVIDER=ollama

# ── Local LLM (Ollama, vLLM, LM Studio) ──────────────────────────
# Base URL of local or EC2 LLM server (e.g. Ollama or vLLM)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# ── AWS Bedrock (No API keys needed — uses IAM roles) ────────────
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0

# ── Anthropic (optional if using LLM_PROVIDER=anthropic) ─────────
ANTHROPIC_API_KEY=

# ── IBM Cloud Object Storage (optional — falls back to local disk) ──
COS_ENDPOINT=
COS_API_KEY_ID=
COS_INSTANCE_CRN=
COS_BUCKET_NAME=

# ── App settings ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
